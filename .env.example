# ClearDoc server configuration
# Copy to .env and adjust as needed.

# HTTP port for the ClearDoc server
PORT=3000

# "development" enables Vite middleware/HMR; "production" serves the built dist/ folder
NODE_ENV="development"

# Upload and processing limits
CLEARDOC_MAX_FILE_SIZE_BYTES=31457280
CLEARDOC_MAX_PAGE_COUNT=50
CLEARDOC_MAX_IMAGE_PIXELS=50000000
CLEARDOC_PROCESSING_DEADLINE_MS=120000

# Temporary file retention and cleanup interval (milliseconds)
CLEARDOC_RETENTION_MS=3600000
CLEARDOC_CLEANUP_INTERVAL_MS=300000

# Shared persistence (V2 multi-instance — optional)
# Set BOTH to run multiple ClearDoc instances against one shared SQLite DB and
# storage volume. Leave both unset for the default single-instance mode.
# The DB path must live on a real local/block volume (not NFS/SMB), which
# breaks SQLite locking.
# CLEARDOC_SHARED_DB_PATH=/var/lib/cleardoc/shared.db
# CLEARDOC_SHARED_STORAGE_ROOT=/var/lib/cleardoc/storage

# Render resolution for previews and verification (DPI)
CLEARDOC_PREVIEW_DPI=150
CLEARDOC_VERIFICATION_DPI=150
