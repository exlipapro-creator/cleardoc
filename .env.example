# ClearDoc server configuration
# Copy to .env and adjust as needed.

# HTTP port for the ClearDoc server
PORT=3000

# "development" enables Vite middleware/HMR; "production" serves the built dist/ folder
NODE_ENV="development"

# Upload and processing limits
CLEARDOC_MAX_FILE_SIZE_BYTES=31457280
CLEARDOC_MAX_PAGE_COUNT=50
# Decoded-pixel ceiling for raster images. Default 16000000 (16 MP) is the
# largest MEASURED-safe value for a 512 MB Render Free instance
# (20 MP measured ~522 MB peak RSS; 41 MP measured ~802 MB). Raise it only on
# instances with more memory.
# CLEARDOC_MAX_IMAGE_PIXELS=16000000
# PDF text-item ceiling. Render memory on text-dense pages scales with
# per-page text OPERATIONS, not file size or page count (a 368 KB PDF with
# ~20,000 text items measured 833 MB peak RSS on this engine). Inspection
# stops early and the upload is rejected before any render.
# CLEARDOC_MAX_TEXT_ITEMS=8000
# Per-page embedded-image pixel ceiling for PDFs. Image-decode CPU scales with
# decoded image pixels, not file bytes: a 6.6 MP image on one page measured
# >15 s of event-loop starvation on a 0.1-CPU Render Free instance (severing
# requests), while 1.4 MP/page passed. Pages over the limit are rejected at
# ingest with 413 PDF_IMAGE_TOO_LARGE. Raise only with more CPU per instance.
# CLEARDOC_MAX_PDF_IMAGE_PIXELS_PER_PAGE=2000000
# Rendered-page pixel ceiling for PDF previews/verification (deterministic
# 400 RENDER_TOO_LARGE instead of a native canvas allocation failure).
# CLEARDOC_MAX_RENDER_PIXELS=16000000
CLEARDOC_PROCESSING_DEADLINE_MS=120000

# Processing admission gate (memory-safety on small instances).
# Max simultaneous expensive processing pipelines, and how long an excess
# request waits for a free slot before receiving 503 SERVICE_BUSY.
# CLEARDOC_MAX_CONCURRENT_PROCESSES=1
# CLEARDOC_PROCESS_SLOT_WAIT_MS=5000

# Bounded graceful-shutdown window for SIGTERM (Render sends it on redeploy).
# CLEARDOC_SHUTDOWN_DEADLINE_MS=10000

# Temporary file retention and cleanup interval (milliseconds)
CLEARDOC_RETENTION_MS=3600000
CLEARDOC_CLEANUP_INTERVAL_MS=300000

# Shared persistence (V2 multi-instance — optional)
# Set BOTH to run multiple ClearDoc instances against one shared SQLite DB and
# storage volume. Leave both unset for the default single-instance mode.
# The DB path must live on a real local/block volume (not NFS/SMB), which
# breaks SQLite locking.
# CLEARDOC_SHARED_DB_PATH=/var/lib/cleardoc/shared.db
# CLEARDOC_SHARED_STORAGE_ROOT=/var/lib/cleardoc/storage

# Render resolution for previews and verification (DPI)
CLEARDOC_PREVIEW_DPI=150
CLEARDOC_VERIFICATION_DPI=150
